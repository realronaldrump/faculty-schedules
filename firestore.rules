// Firestore rules — approval-based access.
// Every approved account can read and write all app data. The owner (the
// developer) additionally approves/disables accounts and reads activity
// telemetry. Data validation lives in the app's write paths, not here: rules
// that validate whole documents reject edits over fields the user never touched.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    function isSelf(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Owner UID is duplicated in src/utils/owner.js (client source of truth);
    // update both places if it ever changes.
    function isOwner() {
      return isSignedIn() && request.auth.uid == 'fjQuh4iAMFYi8URf35Yv5RRijKw2';
    }

    function isActiveProfile(userPath) {
      return exists(userPath) &&
        get(userPath).data.get('status', null) == 'active' &&
        get(userPath).data.get('disabled', false) != true;
    }

    function isApproved() {
      return isOwner() || (
        isSignedIn() &&
        isActiveProfile(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function isAppCollection(collection) {
      return collection in [
        'settings', 'people', 'schedules', 'rooms', 'programs', 'courses', 'terms',
        'reservations', 'roomGrids', 'outlookExceptions', 'emailListPresets',
        'baylorAcronyms', 'changeLog', 'editHistory', 'dedupeDecisions',
        'maintenanceReports', 'importTransactions', 'importRuns', 'importRowLineage',
        'temperatureBuildingSettings', 'temperatureDevices', 'temperatureDeviceReadings',
        'temperatureRoomSnapshots', 'temperatureImports', 'temperatureImportJobs',
        'temperatureRoomAggregates'
      ];
    }

    match /{collection}/{docId} {
      allow read, write: if isAppCollection(collection) && isApproved();
    }

    // Accounts: self-registration creates a pending profile; only the owner
    // approves, disables, or reads other accounts.
    match /users/{userId} {
      allow read: if isSelf(userId) || isOwner();
      allow create: if isSelf(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'pending' &&
        request.resource.data.disabled == false;
      allow update: if isOwner() || (
        isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'lastActiveAt', 'updatedAt'])
      );
      allow delete: if false;
    }

    // Owner-only activity telemetry; only approved accounts record any.
    match /userPresence/{userId} {
      allow read: if isOwner();
      allow create, update: if isSelf(userId) && isApproved() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /userActivityEvents/{id} {
      allow read: if isOwner();
      allow create: if isApproved() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.pageId is string;
      allow update: if false;
      // The owner console prunes events older than the retention window.
      allow delete: if isOwner();
    }

    // Per-user tutorial progress: each user owns their own document; the owner
    // can read every document for the completion view.
    match /tutorialProgress/{userId} {
      allow read: if isSelf(userId) || isOwner();
      allow create, update: if isSelf(userId) && isApproved() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    function isOwnActivityDailySummary(summaryId) {
      return isApproved() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.dateKey is string &&
        request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        summaryId == request.resource.data.dateKey + '_' + request.auth.uid;
    }

    match /userActivityDaily/{id} {
      allow read: if isOwner();
      allow create, update: if isOwner() || isOwnActivityDailySummary(id);
      allow delete: if isOwner();
    }

    match /userActivityAnalyticsDaily/{id} {
      allow read, write: if isOwner();
    }

    match /userActivityPageDaily/{id} {
      allow read, write: if isOwner();
    }

    // Rollup watermark/state for the automatic activity sync.
    match /userActivityMeta/{id} {
      allow read, write: if isOwner();
    }
  }
}
